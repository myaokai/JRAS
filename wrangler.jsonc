{
  "name": "jras",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/sw.js", "/registerSW.js", "/manifest.webmanifest", "/api/*", "/audio/*"]
  },
  // 学習記録の同期（docs/infrastructure.md）。テーブルは段階2-8で migrations/ に定義する
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jras-db",
      "database_id": "97f6a726-4a65-49b4-97fb-4db60df49466",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Access（段階0-7）。アプリ全体を保護し、Cloudflare アカウントでログインする。
  // チームドメインと AUD タグは秘密情報ではない（Zero Trust → Access → Applications「jras」）
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://murakiy1101.cloudflareaccess.com",
    "ACCESS_AUD": "53da01364508ebf3041af0b31b32ab5e2b34338880f9a0c6e289da797cbdb5ed"
  }
}
