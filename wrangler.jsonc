{
  "name": "jras",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/sw.js", "/registerSW.js", "/manifest.webmanifest", "/api/*", "/audio/*"]
  },
  // Cloudflare Access（段階0-7）。設定したらチームドメインと AUD タグを入れる（秘密情報ではない）
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
